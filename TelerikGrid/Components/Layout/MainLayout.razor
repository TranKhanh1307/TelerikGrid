@inherits LayoutComponentBase

<TelerikRootComponent>


    <!-- Header -->
    <header class="app-header">

        <div class="header-left">

            <TelerikButton Class="menu-toggle"
                           Icon="@SvgIcon.Menu"
                           FillMode="@ThemeConstants.Button.FillMode.Clear"
                           OnClick="@ToggleSidebar" />

            <div class="logo-wrapper">
                <span class="logo-title">LiveRoute</span>
                <span class="logo-subtitle">by DialedIn</span>
            </div>

        </div>

        <div class="header-user">
            <div class="user-avatar">HN</div>

            <div class="user-info">
                <div>Helen Nguyen</div>
                <small>Administrator</small>
            </div>
        </div>

    </header>

    <div class="app-body">

        @if (ShowMobileOverlay)
        {
            <div class="sidebar-overlay"
                 @onclick="CloseSidebar">
            </div>
        }

        <!-- Sidebar -->
        <aside class="sidebar @(SidebarOpen ? "open" : "")">

            <div class="sidebar-top">

                <div class="sidebar-title">
                    Menu
                </div>

                <NavLink href="/" Match="NavLinkMatch.All">
                    <span>Dashboard</span>
                </NavLink>

                <NavLink href="/campaigns">
                    <span>Campaigns</span>
                </NavLink>

                <NavLink href="/experts">
                    <span>Experts</span>
                </NavLink>

                <NavLink href="/calls">
                    <span>Calls</span>
                </NavLink>

                <NavLink href="/reports">
                    <span>Reports</span>
                </NavLink>

                <NavLink href="/settings">
                    <span>Settings</span>
                </NavLink>

            </div>

            <div class="sidebar-bottom">

                <TelerikButton Class="logout-btn"
                               Icon="@SvgIcon.Logout">
                    Log Out
                </TelerikButton>

            </div>

        </aside>

        <!-- Content -->
        <main class="app-content">
            @Body
        </main>

    </div>

</TelerikRootComponent>

<TelerikMediaQuery Media="(max-width: 768px)"
                   OnChange="@OnMobileChanged" />

@code {

    private bool IsMobile;
    private bool SidebarOpen = true;

    private bool ShowMobileOverlay =>
        IsMobile && SidebarOpen;

    private void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }

    private void CloseSidebar()
    {
        SidebarOpen = false;
    }

    private void OnMobileChanged(bool matched)
    {
        IsMobile = matched;

        SidebarOpen = !matched;
    }
}