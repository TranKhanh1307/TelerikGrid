@code {
    private bool XSmall { get; set; }
    private bool Small { get; set; }
    private bool Medium { get; set; }
    private bool Large { get; set; }
    // ── Shared state ────────────────────────────────
    private List<Campaign> campaigns = [];
    private List<Campaign> selectedCampaigns = [];
    private string searchKeyword = string.Empty;

    // ── Mobile-only state ───────────────────────────
    private Campaign? openMenuCampaign = null;

    // ── Computed ────────────────────────────────────
    private IEnumerable<Campaign> FilteredCampaigns =>
        string.IsNullOrWhiteSpace(searchKeyword)
            ? campaigns
            : campaigns.Where(c =>
                c.CampaignName.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                c.TrafficSource?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true);

    /// <summary>Drives the mobile select-all checkbox.</summary>
    private bool AllSelected
    {
        get => FilteredCampaigns.Any() && FilteredCampaigns.All(c => selectedCampaigns.Contains(c));
        set => selectedCampaigns = value ? FilteredCampaigns.ToList() : [];
    }

    // ── Lifecycle ────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        campaigns = await CampaignService.GetCampaignsAsync();
    }

    // ── Shared actions ───────────────────────────────
    private async Task DeleteSelectedAsync()
    {
        foreach (var c in selectedCampaigns) campaigns.Remove(c);
        selectedCampaigns = [];
    }

    private void OnDeleteItem(GridCommandEventArgs args)
    {
        campaigns.Remove((Campaign)args.Item);
    }

    private void OnUpdateItem(GridCommandEventArgs args)
    {
        var updated = (Campaign)args.Item;
        var index = campaigns.FindIndex(c => c.Id == updated.Id);
        if (index >= 0) campaigns[index] = updated;
    }

    private void OnScheduleClick(GridCommandEventArgs args)
    {
        // Open availability schedule dialog for (Campaign)args.Item
    }

    private async Task RefreshAsync()
    {
        campaigns = await CampaignService.GetCampaignsAsync();
        selectedCampaigns = [];
    }

    private async Task CopyToClipboardAsync(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    // ── Mobile-only actions ──────────────────────────
    private void ToggleSelection(Campaign item, bool selected)
    {
        if (selected) { if (!selectedCampaigns.Contains(item)) selectedCampaigns.Add(item); }
        else selectedCampaigns.Remove(item);
    }

    private void ToggleCardMenu(Campaign item)
        => openMenuCampaign = openMenuCampaign == item ? null : item;

    private void CloseCardMenu()
        => openMenuCampaign = null;

    private void DeleteCardItem(Campaign item)
    {
        campaigns.Remove(item);
        selectedCampaigns.Remove(item);
        CloseCardMenu();
    }
}
